{
  "name": "reconciliation-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "خادم نظام مطابقة كشوفات الحسابات — Express + TypeScript + PostgreSQL (معمارية نظيفة D10)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:bootstrap": "bash scripts/db-bootstrap.sh",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@node-rs/argon2": "^2.0.2",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "arabic-reshaper": "^1.1.0",
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2"
  }
}
