# نسخ هذا الملف إلى .env ثم تعبئة القيم. لا تضع .env في Git.
# كلمة مرور قاعدة البيانات (استخدم كلمة قوية فريدة).
PGUSER=mushabaka_app
PGDATABASE=reconciliation
PGPASSWORD=ضع-كلمة-مرور-قوية-هنا

# مفتاح تشفير النسخ الاحتياطية: 32 بايت بصيغة ست عشرية (64 حرفاً).
# أنشئه مرة واحدة واحفظه خارج الجهاز؛ بدونه لا يمكن فك أي نسخة.
# PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
BACKUP_ENCRYPTION_KEY=ضع-64-حرفاً-ست-عشرياً-هنا

# المنفذ العام على المضيف (الوكيل/HTTPS أمامه في الإنتاج).
API_PORT=3000
